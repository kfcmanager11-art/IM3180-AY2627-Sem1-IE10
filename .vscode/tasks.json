{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Chess SFML",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-g",
                "main.cpp",
                "board.cpp",
                "UI files\\ui.cpp",
                "-o",
